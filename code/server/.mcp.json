        "GITLAB_ALLOWED_PROJECT_IDS": "67255206,86047720,75976122",
        "GITLAB_READ_ONLY_MODE": "false",
        "GITLAB_TOOLSETS": "users",
        "GITLAB_TOOLS": "get_project,list_issues,get_issue,create_issue,update_issue,list_issue_discussions,create_issue_note,create_note,get_merge_request,create_merge_request,update_merge_request,get_commit,list_commit_statuses,list_pipelines,list_pipeline_jobs,get_pipeline_job_output,wait_for_pipeline",
